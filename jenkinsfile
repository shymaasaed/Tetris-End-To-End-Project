pipeline {
    agent any

    environment {
        APP_NAME = "tetris-backend"
        BUILD_DIR = "backend-artifacts"

        SONAR_HOST = "http://127.0.0.1:9000"
        SONAR_PROJECT_KEY = "tetris-backend"

        IMAGE_NAME = "shymaa145/tetris-backend"
        IMAGE_TAG = "${BUILD_NUMBER}"
        FULL_IMAGE = "${IMAGE_NAME}:${IMAGE_TAG}"
    }

    stages {

        // =====================
        // Checkout
        // =====================

        // =====================
        // Build Backend
        // =====================
        stage('Build Backend') {
            steps {
                sh '''
                docker run --rm \
                  -v $PWD:/app \
                  -w /app \
                  node:18-alpine \
                  sh -c "
                    npm install
                  "

                rm -rf ${BUILD_DIR}
                mkdir -p ${BUILD_DIR}
                cp -r . ${BUILD_DIR}/
                '''
            }
        }

        // =====================
        // OWASP Dependency Check
        // =====================
        stage('OWASP Dependency Check (soft)') {
            steps {
                withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_KEY')]) {
                    sh '''
                    mkdir -p owasp-report

                    docker run --rm \
                      -v $WORKSPACE:/src \
                      -v odc-data:/usr/share/dependency-check/data \
                      owasp/dependency-check \
                      --scan /src \
                      --format HTML \
                      --out /src/owasp-report \
                      --nvdApiKey $NVD_KEY || true
                    '''
                }
            }
        }

        // =====================
        // SonarQube
        // =====================
        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonar-creds', variable: 'SONAR_TOKEN')]) {
                    sh '''
                    docker run --rm \
                      --network host \
                      -v $PWD:/usr/src \
                      sonarsource/sonar-scanner-cli \
                      -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                      -Dsonar.sources=. \
                      -Dsonar.host.url=${SONAR_HOST} \
                      -Dsonar.login=$SONAR_TOKEN || true
                    '''
                }
            }
        }

        // =====================
        // Push Artifacts → Nexus
        // =====================
        stage('Push Artifacts to Nexus') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-creds',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASS')]) {

                    sh '''
                    zip -r backend-build.zip ${BUILD_DIR}

                    curl -u $NEXUS_USER:$NEXUS_PASS \
                      --upload-file backend-build.zip \
                      http://127.0.0.1:8081/repository/raw-hosted/backend-build-${BUILD_NUMBER}.zip
                    '''
                }
            }
        }

        // =====================
        // Docker Build
        // =====================
        stage('Docker Build') {
            steps {
                sh '''
                docker build -t ${FULL_IMAGE} .
                '''
            }
        }

        // =====================
        // Trivy Image Scan
        // =====================
        stage('Trivy Image Scan (soft)') {
            steps {
                sh '''
                trivy image --scanners vuln ${FULL_IMAGE} \
                  --format table \
                  --output trivy-image.txt || true
                '''
            }
        }

        // =====================
        // Docker Push
        // =====================
        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'shymaa145',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {

                    sh '''
                    docker login -u $DOCKER_USER -p $DOCKER_PASS
                    docker push ${FULL_IMAGE}
                    '''
                }
            }
        }

        // =====================
        // Archive Reports
        // =====================
        stage('Archive Reports') {
            steps {
                archiveArtifacts artifacts: 'trivy-image.txt, owasp-report/**', fingerprint: true
            }
        }
    }

    post {
        always {
            echo "Backend Pipeline Finished"
        }
    }
}
